{
  "name": "veskify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:webpack",
    "build:webpack": "next build --webpack",
    "build:turbopack": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && playwright test -c playwright.p10a-08c-01.config.ts && playwright test -c playwright.p10a-04c.config.ts && playwright test -c playwright.p10a-08d-02.config.ts && playwright test -c playwright.p10b-08.config.ts && playwright test -c playwright.p10b-09.config.ts && playwright test -c playwright.p10b-11.config.ts && playwright test -c playwright.p10b-13.config.ts",
    "smoke:openai": "vitest run --config vitest.openai-smoke.config.ts",
    "demo:p9-05a:load": "vitest run --config vitest.p9-05a-demo.config.ts",
    "docs:export:sdd": "node scripts/export-sdd-docx.mjs",
    "docs:export:tracker": "node scripts/export-development-delivery-tracker-docx.mjs",
    "docs:export": "pnpm docs:export:sdd && pnpm docs:export:tracker",
    "docs:check:sdd": "node scripts/export-sdd-docx.mjs --check",
    "docs:check:tracker": "node scripts/export-development-delivery-tracker-docx.mjs --check",
    "docs:check:tooling": "node scripts/documentation-tooling-self-check.mjs",
    "docs:check:requirements": "node scripts/check-requirement-traceability.mjs",
    "docs:validate": "node scripts/validate-documentation.mjs",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "validate:full": "pnpm validate && pnpm test:e2e"
  },
  "dependencies": {
    "@next/env": "^16.2.10",
    "@puckeditor/core": "^0.22.2",
    "idb": "^8.0.3",
    "next": "^16.2.10",
    "openai": "^6.48.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.28.1"
}
